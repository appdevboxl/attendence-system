<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="bg-light">

  <div class="d-flex" id="wrapper">

    <!-- Sidebar -->
    <div class="bg-dark text-white p-3" id="sidebar">
      <h4 class="text-center mb-4">Admin Panel</h4>
      <ul class="nav flex-column">
        <li class="nav-item mb-2"><a href="#users" class="nav-link text-white">👥 Add / Manage Users</a></li>
        <li class="nav-item mb-2"><a href="#attendance" class="nav-link text-white">🗓 Attendance</a></li>
        <li class="nav-item mb-2"><a href="#leaves" class="nav-link text-white">🏖 Holidays & Leaves</a></li>
        <li class="nav-item mb-2"><a href="#announcements" class="nav-link text-white">📢 Announcements</a></li>
        <li class="nav-item mt-4"><a href="/" class="btn btn-danger w-100">Logout</a></li>
      </ul>
    </div>

    <!-- Main Content -->
    <div class="p-4 flex-grow-1" id="content">
      <h2 class="mb-4 text-primary fw-bold">Admin Dashboard</h2>

      <!-- Users Section -->
      <section id="users" class="mb-5">
        <div class="card shadow-sm">
          <div class="card-header bg-primary text-white">Add / Manage Users</div>
          <div class="card-body">
            <form class="row g-3 mb-3">
              <div class="col-md-4"><input type="text" class="form-control" placeholder="User Name"></div>
              <div class="col-md-4"><input type="email" class="form-control" placeholder="Email"></div>
              <div class="col-md-4"><button class="btn btn-success w-100">Add User</button></div>
            </form>

<table class="table table-striped">
  <thead>
    <tr><th>#</th><th>Name</th><th>Email</th><th>Actions</th></tr>
  </thead>
  <tbody>
    <% users.forEach((user, index) => { %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td>
          <a href="/admin/users/edit/<%= user._id %>" class="btn btn-warning btn-sm">Edit</a>
          <form action="/admin/users/delete/<%= user._id %>?_method=DELETE" method="POST" class="d-inline">
            <button class="btn btn-danger btn-sm">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
          </div>
        </div>
      </section>

      <!-- Attendance Section -->
      <section id="attendance" class="mb-5">
        <div class="card shadow-sm">
          <div class="card-header bg-success text-white">Attendance Records</div>
          <div class="card-body">
            <table class="table table-bordered">
              <thead><tr><th>User</th><th>Date</th><th>Status</th><th>Action</th></tr></thead>
              <tbody>
                <tr><td>John Doe</td><td>2025-10-14</td><td>Present</td><td><button class="btn btn-primary btn-sm">Update</button></td></tr>
                <tr><td>Jane Smith</td><td>2025-10-14</td><td>Absent</td><td><button class="btn btn-primary btn-sm">Update</button></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Holidays Section -->
      <section id="leaves" class="mb-5">
        <div class="card shadow-sm">
          <div class="card-header bg-warning">Holidays & Custom Leaves</div>
          <div class="card-body">
            <form class="row g-3 mb-3">
              <div class="col-md-6"><input type="text" class="form-control" placeholder="Holiday Name"></div>
              <div class="col-md-4"><input type="date" class="form-control"></div>
              <div class="col-md-2"><button class="btn btn-success w-100">Add</button></div>
            </form>

            <ul class="list-group">
              <li class="list-group-item d-flex justify-content-between align-items-center">New Year — 2025-01-01 <button class="btn btn-sm btn-danger">Delete</button></li>
              <li class="list-group-item d-flex justify-content-between align-items-center">Festival — 2025-10-15 <button class="btn btn-sm btn-danger">Delete</button></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Announcements Section -->
      <section id="announcements" class="mb-5">
  <div class="card shadow-sm">
    <div class="card-header bg-info text-white">Announcements</div>
    <div class="card-body">
      
      <!-- Add Announcement Form -->
      <form class="row g-3 mb-3" action="/announcements/add" method="POST">
        <div class="col-md-10">
          <input type="text" name="message" class="form-control" placeholder="Write announcement..." required>
        </div>
        <div class="col-md-2">
          <button class="btn btn-primary w-100">Post</button>
        </div>
      </form>

      <!-- Dynamic Announcements List -->
      <ul class="list-group">
        <% if (announcements.length > 0) { %>
          <% announcements.forEach((a) => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <%= a.message %>
              <form action="/announcements/delete/<%= a._id %>" method="POST" class="m-0">
                <button class="btn btn-sm btn-outline-danger">Remove</button>
              </form>
            </li>
          <% }) %>
        <% } else { %>
          <li class="list-group-item text-center text-muted">No announcements yet</li>
        <% } %>
      </ul>

    </div>
  </div>
</section>


    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
