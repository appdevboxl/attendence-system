<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="bg-light">

  <div class="d-flex" id="wrapper">

    <!-- Sidebar -->
    <div class="bg-dark text-white p-3" id="sidebar">
      <h4 class="text-center mb-4">Admin Panel</h4>
      <ul class="nav flex-column">
        <li class="nav-item mb-2"><a href="#users" class="nav-link text-white">👥 Add / Manage Users</a></li>
        <li class="nav-item mb-2"><a href="#attendance" class="nav-link text-white">🗓 Attendance</a></li>
        <!-- <li class="nav-item mb-2"><a href="#leaves" class="nav-link text-white">🏖 Holidays & Leaves</a></li> -->
        <li class="nav-item mb-2"><a href="#announcements" class="nav-link text-white">📢 Announcements</a></li>
        <li class="nav-item mt-4"><a href="/" class="btn btn-danger w-100">Logout</a></li>
      </ul>
    </div>

    <!-- Main Content -->
    <div class="p-4 flex-grow-1" id="content">
      <h2 class="mb-4 text-primary fw-bold">Admin Dashboard</h2>

      <!-- Users Section -->
      <section id="users" class="mb-5">
        <div class="card shadow-sm">
          <div class="card-header bg-primary text-white">Add / Manage Users</div>
          <div class="card-body">
            <form action="/addUser" method="POST" class="row g-3 mb-3">
  <div class="col-md-3">
    <input type="text" name="name" class="form-control" placeholder="User Name" required>
  </div>
  <div class="col-md-3">
    <input type="email" name="email" class="form-control" placeholder="Email" required>
  </div>
  <div class="col-md-3">
    <input type="password" name="password" class="form-control" placeholder="Password" required>
  </div>
  <div class="col-md-3">
    <button type="submit" class="btn btn-success w-100">Add User</button>
  </div>
</form>

<table class="table table-striped">
  <thead>
    <tr><th>#</th><th>Name</th><th>Email</th><th>Actions</th></tr>
  </thead>
  <tbody>
    <% users.forEach((user, index) => { %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td>
          <a href="/users/edit/<%= user._id %>" class="btn btn-warning btn-sm">Edit</a>
          <form 
            action="/users/delete/<%= user._id %>?_method=DELETE" 
            method="POST" 
            class="d-inline delete-form">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
           </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
          </div>
        </div>
      </section>

      <!-- Attendance Section -->
      <section id="attendance" class="mb-5">
  <div class="card shadow-sm">
    <div class="card-header bg-success text-white">Attendance Records</div>
    <div class="card-body table-responsive">
      <table class="table table-bordered align-middle">
        <thead class="table-light">
          <tr>
            <th>User</th>
            <th>Email</th>
            <th>Date</th>
            <th>Day Type</th>
            <th>Check In</th>
            <th>Check Out</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% attendanceRecords.forEach(record => { %>
            <tr>
              <td><%= record.userId ? record.userId.name : "Unknown" %></td>
              <td><%= record.userId ? record.userId.email : "-" %></td>
              <td><%= record.date.toISOString().split("T")[0] %></td>
              <td><%= record.dayType || "-" %></td>
              <td><%= record.checkIn || "-" %></td>
              <td><%= record.checkOut || "-" %></td>
              <td>
                <button class="btn btn-primary btn-sm" onclick="confirmUpdate('<%= record._id %>')">Update</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

      <!-- Holidays Section -->
      <!-- <section id="leaves" class="mb-5">
        <div class="card shadow-sm">
          <div class="card-header bg-warning">Holidays & Custom Leaves</div>
          <div class="card-body">
            <form class="row g-3 mb-3">
              <div class="col-md-6"><input type="text" class="form-control" placeholder="Holiday Name"></div>
              <div class="col-md-4"><input type="date" class="form-control"></div>
              <div class="col-md-2"><button class="btn btn-success w-100">Add</button></div>
            </form>

            <ul class="list-group">
              <li class="list-group-item d-flex justify-content-between align-items-center">New Year — 2025-01-01 <button class="btn btn-sm btn-danger">Delete</button></li>
              <li class="list-group-item d-flex justify-content-between align-items-center">Festival — 2025-10-15 <button class="btn btn-sm btn-danger">Delete</button></li>
            </ul>
          </div>
        </div>
      </section> -->

      <!-- Announcements Section -->
      <section id="announcements" class="mb-5">
  <div class="card shadow-sm">
    <div class="card-header bg-info text-white">Announcements</div>
    <div class="card-body">
      
      <!-- Add Announcement Form -->
      <form class="row g-3 mb-3" action="/announcements/add" method="POST">
        <div class="col-md-10">
          <input type="text" name="message" class="form-control" placeholder="Write announcement..." required>
        </div>
        <div class="col-md-2">
          <button class="btn btn-primary w-100">Post</button>
        </div>
      </form>

      <!-- Dynamic Announcements List -->
      <ul class="list-group">
        <% if (announcements.length > 0) { %>
          <% announcements.forEach((a) => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <%= a.message %>
              <form action="/announcements/delete/<%= a._id %>" method="POST" class="m-0">
                <button class="btn btn-sm btn-outline-danger">Remove</button>
              </form>
            </li>
          <% }) %>
        <% } else { %>
          <li class="list-group-item text-center text-muted">No announcements yet</li>
        <% } %>
      </ul>

    </div>
  </div>
</section>


    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  document.querySelectorAll('.delete-form').forEach(form => {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      Swal.fire({
        title: 'Are you sure?',
        text: "This user will be permanently deleted!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Yes, delete it!'
      }).then((result) => {
        if (result.isConfirmed) {
          form.submit();
        }
      });
    });
  });
</script>
<script>
  function confirmUpdate(id) {
    if (confirm("Are you sure you want to update this record?")) {
      window.location.href = `/attendance/update/${id}`;
    }
  }
</script>
</body>
</html>
