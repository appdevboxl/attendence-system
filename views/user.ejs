<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Employee Dashboard</title>

  <!-- Bootstrap CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container-fluid">
      <span class="navbar-brand fw-bold">Employee Dashboard</span>
      <div class="d-flex align-items-center">
        <span class="text-white me-3">Welcome, <%= employee.name %></span>
        <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h5 class="card-title">Announcements</h5>
            <hr>
            <% if (announcements && announcements.length > 0) { %>
              <ul class="list-group list-group-flush">
                <% announcements.forEach(a => { %>
                  <li class="list-group-item">
                    <p class="mb-1"><%= a.message %></p>
                    <small class="text-muted">
                      Posted on <%= new Date(a.createdAt).toLocaleString() %>
                    </small>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <p class="text-muted mb-0">No announcements available.</p>
            <% } %>
          </div>
        </div>
        <!-- Employee Info -->
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h5 class="card-title">Employee Details</h5>
            <hr>
            <p><strong>ID:</strong> <%= employee._id %></p>
            <p><strong>Name:</strong> <%= employee.name %></p>
            <p><strong>Email:</strong> <%= employee.email %></p>
            <p><strong>Role:</strong> <%= employee.role %></p>
            <p><strong>Active:</strong> <%= employee.isActive ? "Yes" : "No" %></p>
            <p><strong>Created:</strong> <%= new Date(employee.createdAt).toLocaleString() %></p>
          </div>
        </div>

        <input type="hidden" id="employeeId" value="<%= employee._id %>">

        <!-- Punch In / Punch Out -->
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h5 class="card-title">Attendance</h5>
            <hr>
            <form id="punchForm" class="mb-3">
              <div class="d-grid gap-2">
                <button type="button" class="btn btn-success" data-action="in">Punch In</button>
                <button type="button" class="btn btn-danger" data-action="out">Punch Out</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Announcements -->
        

      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.querySelectorAll('#punchForm button').forEach(button => {
      button.addEventListener('click', async () => {
        const action = button.dataset.action; // "in" or "out"
        const employeeId = document.getElementById('employeeId').value;

        const url = action === 'in'
          ? `http://localhost:3000/punchin/${employeeId}`
          : `http://localhost:3000/punchout/${employeeId}`;

        try {
          const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });

          const data = await response.json();
          alert(data.message || 'Action completed');
        } catch (err) {
          console.error(err);
          alert('Something went wrong');
        }
      });
    });
  </script>

</body>
</html>
